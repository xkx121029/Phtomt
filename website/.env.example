# ===== 官网服务端配置 =====
# 监听端口（避开 Windows 的保留端口段，8787/8080 之类在某些机器上会 EACCES）
PORT=5180

# 管理后台登录口令。留空则每次启动随机生成并打印在控制台。
ADMIN_PASSWORD=phtomt-admin

# 管理令牌签名盐值，部署时务必改成长随机串
ADMIN_SECRET=change-me-to-a-long-random-string

# 管理令牌有效期（小时）
ADMIN_TOKEN_TTL=72

# APK 存放目录（相对 website 根目录），上传与下载都走这里
APK_DIR=public/apk

# 内容数据目录
DATA_DIR=server/data

# 站点对外地址，用于生成下载链接与 sitemap
SITE_ORIGIN=http://localhost:5180

# 单次 APK 上传大小上限（MB）
MAX_APK_MB=200

# 允许跨域的来源，逗号分隔；留空表示不开启 CORS
# GitHub Pages 静态站回连本服务时需要放行，例如：
# CORS_ORIGINS=https://xkx121029.github.io
CORS_ORIGINS=

# ===== happy-hub 文件中枢（可选） =====
# 配置后 APK 会上传一份到中枢，官网下载直接 302 到签名直链；留空则回退本地磁盘
# 例：HUB_URL=http://192.168.2.16:8090
HUB_URL=
# 官网应用的一次性令牌（在 hub 管理台「应用」里创建后复制）
HUB_TOKEN=
# 存放包体的桶，默认 packages
HUB_BUCKET=packages
# 对象键前缀，默认 apk/；留空表示直接用文件名
HUB_PREFIX=apk

# ===== GitHub Releases 同步（可选） =====
# 配置后每次发布版本会把 APK 同时传到对应 tag 的 Release；
# 令牌需要 Contents: write（细粒度）或 repo（经典 PAT）权限
GITHUB_REPO=xkx121029/Phtomt
GITHUB_TOKEN=
# 这些渠道建成 pre-release，默认 beta,dev,nightly
GITHUB_PRERELEASE_CHANNELS=beta,dev,nightly
