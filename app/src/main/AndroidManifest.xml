<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 编码 Agent 宿主前台服务：targetSdk 34 起，dataSync 型 FGS 必须显式声明该权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 自动更新：优先走 shell 静默安装；通道不可用时回落到系统安装器，
         后者要求本应用持有「安装未知应用」权限（Android 8.0 起按来源应用单独授权） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Termux 执行通道已迁入 Provider（com.phoneagent.provider）：
         RUN_COMMAND 权限、RunCommandService 调用与结果回传接收器都在 Provider 内，
         主应用不再声明该权限 -->
    <!-- 内置 Shizuku 已迁入 Provider：WRITE_SECURE_SETTINGS 与 moe.shizuku.manager.permission.API_V23
         由 Provider 应用声明，主应用只经 AIDL 远程调用 -->

    <!-- 绑定 Provider 的 AIDL 服务所需：Provider 侧把 ProviderService 声明为
         android:permission="com.phoneagent.permission.BIND_PROVIDER"（signature 级），
         不声明此 uses-permission 会在 bindService 时直接抛 SecurityException -->
    <uses-permission android:name="com.phoneagent.permission.BIND_PROVIDER" />

    <!-- 端侧语音输入：SpeechRecognizer（Android 11 起强制要求 RECORD_AUDIO） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 包可见性：Termux 探测已迁入 Provider（Provider 自行声明对 com.termux 的可见性），
         主应用无需再查询该包。
         Provider 自身必须可见：主应用要查询其安装状态/版本并 bindService，Android 11+
         未在 <queries> 声明时 getPackageInfo 会抛 NameNotFoundException（isInstalled 恒 false），
         表现为「服务组件永远显示未安装、无障碍永远连不上」 -->
    <queries>
        <package android:name="com.phoneagent.provider" />
    </queries>

    <!-- 明文 HTTP：API 地址允许指向自建/内网服务（http://192.168.1.5:8000、http://nas.local、
         http://localhost:11434 等）。targetSdk 28 起系统默认禁止明文流量，不放开时 OkHttp 会直接抛
         "CLEARTEXT communication to xxx not permitted by network security policy"。 -->
    <application
        android:name=".PhoneAgentApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneAgent"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- windowSoftInputMode 必须显式声明为 adjustResize：
             不声明时系统按 adjustUnspecified 自行选择，非滚动容器（Compose 根视图不是 ScrollView）
             可能被判成 adjustPan —— 系统把整个窗口内容往上平移，而输入区自己又用 imePadding()
             避让 IME，两者叠加就会把输入区顶到比键盘顶更高，中间空出一块。
             edge-to-edge（enableEdgeToEdge + targetSdk 35）下 adjustResize 不会压缩窗口，
             IME 只通过 WindowInsets.ime 上报，由页面内的 imePadding() 决定输入区位置。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PhoneAgent"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 深链：hpa://task?text=… 开任务、hpa://resume 续跑（website 任务卡片/厂商助手训练计划共用） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hpa" android:host="task" />
                <data android:scheme="hpa" android:host="resume" />
            </intent-filter>
            <!-- 分享目标：任何 App 分享文字/链接 → 交给 Agent -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 文本选择处理：任何 App 选中文字 →「问 Happy Agent」 -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 长按图标快捷方式 + Google App Actions capability -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 语音输入交互 Demo：长按录音 → 音量气泡 → 上滑预览/取消 → 松手分发 -->
        <activity
            android:name=".ui.voice.VoiceDemoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 无障碍服务已迁入 Provider（com.phoneagent.provider）：
             AgentAccessibilityService 与 accessibility_service_config 的声明在 Provider Manifest 中，
             主应用只经 AIDL 读取元素树 / 执行动作 -->

        <service
            android:name=".device.screen.ScreenSharingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".overlay.FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="com.phoneagent.agent_progress_overlay" />
        </service>

        <!-- 编码 Agent 宿主：前台服务保活 node 编码进程（vibecoding 模式，com.phoneagent.coding 嵌入层） -->
        <service
            android:name=".coding.CodingAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 代码编辑器（coding 嵌入层）：WebView 里跑随包发布的编辑页面，读写 happy_ACA 工作区 -->
        <activity
            android:name=".coding.EditorActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 代码预览（coding 嵌入层）：渲染工作区里的 HTML，或 agent 起的本地预览服务 -->
        <activity
            android:name=".coding.PreviewActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".feature.edge.EdgeLightingService"
            android:exported="false" />

        <!-- 点击光标覆盖层：任务执行时显示圆润指针，指示 AI 正在点哪里 -->
        <service
            android:name=".overlay.CursorOverlayService"
            android:exported="false" />

        <!-- 页面记忆标记覆盖层：命中已记忆页面时在已知控件位置画淡色圆环（不拦截触摸） -->
        <service
            android:name=".overlay.PageMarkOverlayService"
            android:exported="false" />

        <!-- 无线 ADB 配对接收器已迁入 Provider（com.phoneagent.provider）：
             通知栏内联输入配对码的回调在 Provider 进程内处理，主应用的配对码改在设置页输入 -->

        <!-- 快速设置磁贴：下拉通知栏一键唤起/收起任务悬浮窗 -->
        <service
            android:name=".overlay.AgentTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 任务状态 Widget：引擎每步推送状态时经 AgentStatusStore 刷新 -->
        <receiver
            android:name=".overlay.AgentStatusWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agent_status_widget_info" />
        </receiver>

        <!-- 通知感知：AI 的通知维度上下文（验证码/提醒）+ 读取/清理通知技能 -->
        <service
            android:name=".feature.notify.AgentNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 数字助理：注册为默认助理后，长按电源键/边缘手势唤起（携带当前屏幕上下文） -->
        <service
            android:name=".feature.assistant.HpaVoiceInteractionService"
            android:exported="true"
            android:label="@string/voice_interaction_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voiceinteraction"
                android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name=".feature.assistant.HpaVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- 对外控制接口：Tasker/MacroDroid 等广播下发任务/查询状态（设置里开关+口令双闸门） -->
        <receiver
            android:name=".feature.entry.TaskControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.phoneagent.action.EXTERNAL_RUN_TASK" />
                <action android:name="com.phoneagent.action.EXTERNAL_STOP_TASK" />
                <action android:name="com.phoneagent.action.EXTERNAL_QUERY_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Termux 结果回传接收器已迁入 Provider（com.phoneagent.provider）：
             PendingIntent 回传的 TERMUX_RESULT 广播由 Provider 内的接收器处理 -->

        <!-- 自动更新：把下载到私有目录的安装包授权给系统安装器（targetSdk 24 起禁止 file:// 外传） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- ShizukuProvider 与权限确认页已迁入 Provider（com.phoneagent.provider）：
             rikka.shizuku.ShizukuProvider 与 ShizukuPermissionActivity 在 Provider Manifest 中声明，
             主应用不再打包 Shizuku 客户端库 -->
    </application>

</manifest>